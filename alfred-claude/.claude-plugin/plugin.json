{
  "name": "alfred",
  "version": "0.1.9",
  "description": "Personal assistant workflow for Claude Code: boot briefing, decision-first project logs, work traces, daily notes. The user decides; Alfred organizes.",
  "author": {
    "name": "Ungbin_Oh"
  },
  "license": "MIT",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/session-start.sh\"",
            "timeout": 5,
            "statusMessage": "Loading Alfred..."
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PLUGIN_ROOT}/hooks/manual-mode.sh\"",
            "timeout": 5,
            "statusMessage": "Checking manual mode..."
          }
        ]
      }
    ]
  }
}
